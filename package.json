{
  "name": "the-everything-timeline",
  "version": "1.0.0",
  "description": "An interactive timeline from the Big Bang to modern day",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.js && node scripts/check-overlay-lifespan.js && node scripts/check-nations.js && node scripts/check-labels.js && node scripts/check-cities.js",
    "validate:strict": "node scripts/validate-data.js --strict",
    "validate:schema": "node scripts/validate-data.js",
    "build:nations": "node scripts/build-nations.mjs && node scripts/build-nations.mjs --fine",
    "build:nations:fine": "node scripts/build-nations.mjs --fine",
    "build:places": "node scripts/build-places.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthur-fox/the-everything-timeline.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arthur-fox/the-everything-timeline/issues"
  },
  "homepage": "https://github.com/arthur-fox/the-everything-timeline#readme",
  "devDependencies": {
    "ajv": "^8.20.0",
    "d3-geo": "^3.1.1",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "globe.gl": "^2.46.2",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0"
  }
}
